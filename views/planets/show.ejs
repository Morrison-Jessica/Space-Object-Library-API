<%- include('../partials/head', { pageTitle: 'Planet Show' }) %>

<section class="panel">
  <h2>Planet Show</h2>
  <p><strong>ID:</strong> <%= planet.id %></p>
  <p><strong>Name:</strong> <%= planet.name %></p>
  <% if (planet.imageUrl) { %>
    <p><img src="<%= planet.imageUrl %>" alt="<%= planet.name %>" class="hero-image" /></p>
  <% } %>
  <form action="/planets/<%= planet.id %>?_method=DELETE" method="POST">
    <button type="submit">Delete Planet</button>
  </form>
  <p>
    <a href="/planets">Back to Planets</a>
    |
    <a href="/planets/<%= planet.id %>/edit">Edit Planet</a>
  </p>
</section>

<%- include('../partials/footer') %>
