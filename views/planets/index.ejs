<%- include('../partials/head', { pageTitle: 'Planets Index' }) %>

<section class="panel">
  <h2>Planets Index</h2>
  <p>Phase 3: Planet index now renders from a GET route.</p>
  <p><a href="/planets/new">Create Planet</a></p>
  <ul>
    <% planets.forEach((planet) => { %>
      <li>
        <a href="/planets/<%= planet.id %>"><%= planet.name %></a>
        |
        <a href="/planets/<%= planet.id %>/edit">Edit</a>
        |
        <form action="/planets/<%= planet.id %>?_method=DELETE" method="POST" style="display:inline;">
          <button type="submit">Delete</button>
        </form>
      </li>
    <% }) %>
  </ul>
</section>

<%- include('../partials/footer') %>
